---
import { faqs } from '../../data/home';
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-center mb-12">Frequently Asked Questions</h2>
  <div class="space-y-4">
    {faqs.map((f) => (
      <details class="group bg-white dark:bg-forest-700 rounded-2xl border border-leaf-200 dark:border-forest-600 p-5 cursor-pointer">
        <summary class="flex justify-between items-center font-semibold list-none">
          {f.q}
          <span class="text-[#2d5a3f] group-open:rotate-45 transition text-2xl leading-none">+</span>
        </summary>
        <p class="mt-3 text-forest-700/80 dark:text-leaf-200/80 text-sm">{f.a}</p>
      </details>
    ))}
  </div>
</section>
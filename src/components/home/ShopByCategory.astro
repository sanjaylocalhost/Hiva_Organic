---
import { categories } from '../../data/home';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="text-center mb-12">
    <p class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 uppercase tracking-widest mb-2">Explore</p>
    <h2 class="font-display text-3xl md:text-4xl font-bold">Shop by Category</h2>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    {categories.map((c) => (
      <a href={c.href} class="group relative rounded-2xl overflow-hidden aspect-square shadow-md hover:shadow-xl transition">
        <img src={c.img} alt={c.name} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-4">
          <h3 class="text-white font-semibold text-lg">{c.name}</h3>
        </div>
      </a>
    ))}
  </div>
</section>
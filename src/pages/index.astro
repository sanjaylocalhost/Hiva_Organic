---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';

const categories = [
  { name: 'Cold Pressed Oils', img: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=600', href: '/shop/oils' },
  { name: 'Raw Honey', img: 'https://images.unsplash.com/photo-1587049352846-4a222e784d38?w=600', href: '/shop/honey' },
  { name: 'Organic Spices', img: 'https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=600', href: '/shop/spices' },
  { name: 'Pantry Essentials', img: 'https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=600', href: '/shop/pantry' },
];

const testimonials = [
  { name: 'Priya Sharma', location: 'Mumbai', text: 'The coconut oil smells exactly like my grandmother used to make. Absolutely pure!', rating: 5 },
  { name: 'Rahul Verma', location: 'Bangalore', text: 'Switched my entire kitchen to HIVA. The quality is unmatched and delivery is fast.', rating: 5 },
  { name: 'Anjali Nair', location: 'Kochi', text: 'Raw honey is the real deal — crystallizes naturally, just like it should.', rating: 5 },
];

const faqs = [
  { q: 'What is cold-pressed oil?', a: 'Cold pressing extracts oil at low temperatures without chemicals, preserving natural nutrients, aroma, and flavor.' },
  { q: 'How long does delivery take?', a: 'We deliver within 3–5 business days across India. Free shipping on orders above ₹599.' },
  { q: 'Are your products organic?', a: 'Yes! All our products are sourced from certified organic farms and are free from additives or preservatives.' },
  { q: 'Do you offer returns?', a: 'We offer a 7-day return policy on unopened products. Contact us at support@hiva.com for assistance.' },
];
---

<Layout title="HIVA — Pure Organic Products">
  <Header />

  <!-- 1. HERO SLIDER -->
  <section class="relative w-full h-[500px] md:h-[600px] overflow-hidden bg-gray-100">
    <div id="slider" class="flex h-full w-full transition-transform duration-700 ease-in-out">
      <div class="min-w-full h-full relative">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=2000&auto=format&fit=crop" alt="Cold Pressed Coconut Oil" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/20 flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-lg text-white drop-shadow-lg">
              <h2 class="text-4xl md:text-5xl font-serif mb-2">Cold Pressed</h2>
              <h1 class="text-5xl md:text-6xl font-serif font-bold mb-4 text-[#1f3f2b]">Coconut Oil</h1>
              <p class="text-lg mb-6">Traditionally wood pressed to preserve natural aroma, flavour and nutrition.</p>
              <a href="/shop" class="inline-block px-8 py-3 rounded-full bg-[#2d5a3f] hover:bg-[#1f3f2b] text-white font-semibold transition">Shop now</a>
            </div>
          </div>
        </div>
      </div>
      <div class="min-w-full h-full relative">
        <img src="https://images.unsplash.com/photo-1471943311424-646960669fbc?q=80&w=2000&auto=format&fit=crop" alt="Organic Honey" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/20 flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-lg text-white drop-shadow-lg">
              <h2 class="text-4xl md:text-5xl font-serif mb-2">Raw & Pure</h2>
              <h1 class="text-5xl md:text-6xl font-serif font-bold mb-4 text-[#1f3f2b]">Organic Honey</h1>
              <p class="text-lg mb-6">Straight from the hive, unprocessed and full of natural goodness.</p>
              <a href="/shop" class="inline-block px-8 py-3 rounded-full bg-[#2d5a3f] hover:bg-[#1f3f2b] text-white font-semibold transition">Shop now</a>
            </div>
          </div>
        </div>
      </div>
      <div class="min-w-full h-full relative">
        <img src="https://images.unsplash.com/photo-1509358271058-acd22cc93898?q=80&w=2000&auto=format&fit=crop" alt="Organic Pantry" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/20 flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-lg text-white drop-shadow-lg">
              <h2 class="text-4xl md:text-5xl font-serif mb-2">Wholesome</h2>
              <h1 class="text-5xl md:text-6xl font-serif font-bold mb-4 text-[#1f3f2b]">Pantry Essentials</h1>
              <p class="text-lg mb-6">Sourced with care, made without compromise.</p>
              <a href="/shop" class="inline-block px-8 py-3 rounded-full bg-[#2d5a3f] hover:bg-[#1f3f2b] text-white font-semibold transition">Shop now</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button id="prevBtn" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-12 h-12 flex items-center justify-center rounded-md transition z-10">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button id="nextBtn" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-12 h-12 flex items-center justify-center rounded-md transition z-10">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div id="dots" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
      <button class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" data-index="0"></button>
      <button class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" data-index="1"></button>
      <button class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition" data-index="2"></button>
    </div>
  </section>

  <!-- 2. TRUST BADGES BAR -->
  <section class="bg-[#2d5a3f] text-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
        <p class="text-sm font-semibold">100% Organic</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <p class="text-sm font-semibold">Free Shipping ₹599+</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <p class="text-sm font-semibold">Secure Payments</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9"/><polyline points="3 4 3 12 11 12"/></svg>
        <p class="text-sm font-semibold">Easy Returns</p>
      </div>
    </div>
  </section>

  <!-- 3. SHOP BY CATEGORY -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 uppercase tracking-widest mb-2">Explore</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold">Shop by Category</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {categories.map(c => (
        <a href={c.href} class="group relative rounded-2xl overflow-hidden aspect-square shadow-md hover:shadow-xl transition">
          <img src={c.img} alt={c.name} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-4">
            <h3 class="text-white font-semibold text-lg">{c.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. BEST SELLERS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-8">
      <h2 class="font-display text-3xl font-bold">Best Sellers</h2>
      <a href="/shop" class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 hover:underline">View all →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map(p => (
        <a href={`/product/${p.slug}`} class="group rounded-2xl bg-white dark:bg-forest-700 border border-leaf-200 dark:border-forest-600 overflow-hidden hover:shadow-lg transition">
          <div class="aspect-square bg-leaf-100 dark:bg-forest-600 flex items-center justify-center text-leaf-400 text-sm">Image</div>
          <div class="p-5">
            <p class="text-xs text-leaf-600 dark:text-leaf-300 uppercase tracking-wide mb-1">{p.category}</p>
            <h3 class="font-semibold text-lg mb-1 group-hover:text-leaf-600 dark:group-hover:text-leaf-300">{p.name}</h3>
            <p class="text-sm text-forest-700/70 dark:text-leaf-200/70 line-clamp-2">{p.description}</p>
            <p class="mt-3 font-semibold">From ₹{Math.min(...p.variants.map(v => v.price))}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. OUR PROCESS -->
  <section class="bg-leaf-50 dark:bg-forest-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 uppercase tracking-widest mb-2">How It's Made</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold">From Farm to Your Kitchen</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {[
          { n: '01', t: 'Sourced', d: 'Handpicked from certified organic farms.' },
          { n: '02', t: 'Cold Pressed', d: 'Wood-pressed below 40°C to retain nutrients.' },
          { n: '03', t: 'Quality Tested', d: 'Lab-tested for purity, every single batch.' },
          { n: '04', t: 'Delivered Fresh', d: 'Sealed & shipped within 48 hours.' },
        ].map(s => (
          <div class="text-center">
            <div class="w-16 h-16 mx-auto rounded-full bg-[#2d5a3f] text-white flex items-center justify-center font-bold text-xl mb-4">{s.n}</div>
            <h3 class="font-semibold text-lg mb-2">{s.t}</h3>
            <p class="text-sm text-forest-700/70 dark:text-leaf-200/70">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. FEATURED PRODUCT SPOTLIGHT -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid md:grid-cols-2 gap-12 items-center">
    <div class="rounded-3xl overflow-hidden shadow-xl">
      <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=1000" alt="Coconut Oil" class="w-full h-full object-cover" />
    </div>
    <div>
      <p class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 uppercase tracking-widest mb-2">Product Spotlight</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Pure Cold-Pressed Coconut Oil</h2>
      <p class="text-forest-700/80 dark:text-leaf-200/80 mb-6">Extracted from sun-dried coconuts using traditional wood-press methods. Rich in MCTs, perfect for cooking, skin, and hair.</p>
      <ul class="space-y-3 mb-8">
        <li class="flex items-center gap-3"><span class="text-[#2d5a3f]">✓</span> 100% Pure & Unrefined</li>
        <li class="flex items-center gap-3"><span class="text-[#2d5a3f]">✓</span> No Chemicals or Preservatives</li>
        <li class="flex items-center gap-3"><span class="text-[#2d5a3f]">✓</span> Glass Bottle Packaging</li>
      </ul>
      <a href="/shop" class="inline-block px-8 py-3 rounded-full bg-[#2d5a3f] hover:bg-[#1f3f2b] text-white font-semibold transition">Buy Now — ₹499</a>
    </div>
  </section>

  <!-- 7. BENEFITS -->
  <section class="bg-leaf-100 dark:bg-forest-700 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-12">Health Benefits</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { i: '❤️', t: 'Heart Healthy' },
          { i: '🧠', t: 'Boosts Immunity' },
          { i: '✨', t: 'Glowing Skin' },
          { i: '💪', t: 'Rich in Nutrients' },
        ].map(b => (
          <div class="p-6 rounded-2xl bg-white dark:bg-forest-600 shadow-sm">
            <div class="text-4xl mb-3">{b.i}</div>
            <p class="font-semibold">{b.t}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. WHY CHOOSE HIVA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h2 class="font-display text-3xl md:text-4xl font-bold mb-12">Why Choose HIVA</h2>
    <div class="grid gap-8 md:grid-cols-3">
      {[
        { t: 'Cold Pressed', d: 'Traditional extraction preserves natural nutrients and aroma.' },
        { t: 'No Additives', d: 'Nothing artificial. No preservatives. Just honest food.' },
        { t: 'Farm Sourced', d: 'Directly from trusted farmers across India.' },
      ].map(f => (
        <div class="p-6 rounded-2xl bg-white dark:bg-forest-600 shadow-sm">
          <h3 class="font-semibold text-lg mb-2">{f.t}</h3>
          <p class="text-sm text-forest-700/70 dark:text-leaf-200/70">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 9. TESTIMONIALS -->
  <section class="bg-[#2d5a3f] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-12">What Our Customers Say</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.map(t => (
          <div class="bg-white/10 backdrop-blur p-6 rounded-2xl text-left">
            <div class="text-yellow-400 mb-3">{'★'.repeat(t.rating)}</div>
            <p class="mb-4 italic">"{t.text}"</p>
            <p class="font-semibold">{t.name}</p>
            <p class="text-sm opacity-80">{t.location}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. CERTIFICATIONS -->
  <section class="py-16 border-b border-leaf-200 dark:border-forest-700">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-sm uppercase tracking-widest text-forest-700/60 dark:text-leaf-200/60 mb-6">Certified & Trusted By</p>
      <div class="flex flex-wrap justify-center items-center gap-8 opacity-70">
        <div class="text-2xl font-bold">🌿 INDIA ORGANIC</div>
        <div class="text-2xl font-bold">✅ FSSAI</div>
        <div class="text-2xl font-bold">🌱 USDA ORGANIC</div>
        <div class="text-2xl font-bold">🏅 ISO 22000</div>
      </div>
    </div>
  </section>

  <!-- 11. INSTAGRAM GALLERY -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-10">
      <p class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 uppercase tracking-widest mb-2">Follow Us</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold">@hiva.organic</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500',
        'https://images.unsplash.com/photo-1471943311424-646960669fbc?w=500',
        'https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=500',
        'https://images.unsplash.com/photo-1587049352846-4a222e784d38?w=500',
      ].map(img => (
        <a href="#" class="aspect-square rounded-xl overflow-hidden group">
          <img src={img} alt="Instagram" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
        </a>
      ))}
    </div>
  </section>

  <!-- 12. BLOG / RECIPES -->
  <section class="bg-leaf-50 dark:bg-forest-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold">From Our Blog</h2>
        <a href="/blog" class="text-sm font-semibold text-leaf-600 dark:text-leaf-300 hover:underline">View all →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { t: '5 Benefits of Cold-Pressed Coconut Oil', img: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=600' },
          { t: 'Why Raw Honey Crystallizes (And Why It\'s Good)', img: 'https://images.unsplash.com/photo-1587049352846-4a222e784d38?w=600' },
          { t: 'Cooking with Cold-Pressed Oils: A Beginner\'s Guide', img: 'https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=600' },
        ].map(b => (
          <a href="/blog" class="group bg-white dark:bg-forest-700 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition">
            <div class="aspect-video overflow-hidden">
              <img src={b.img} alt={b.t} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            </div>
            <div class="p-5">
              <p class="text-xs text-leaf-600 dark:text-leaf-300 uppercase tracking-wide mb-2">Wellness</p>
              <h3 class="font-semibold text-lg group-hover:text-leaf-600 dark:group-hover:text-leaf-300">{b.t}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 13. NEWSLETTER -->
  <section class="bg-[#1f3f2b] text-white py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Get 10% Off Your First Order</h2>
      <p class="mb-8 opacity-90">Subscribe for recipes, wellness tips and exclusive offers.</p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
        <input type="email" placeholder="Your email address" class="flex-1 px-5 py-3 rounded-full text-gray-900 outline-none" required />
        <button type="submit" class="px-8 py-3 rounded-full bg-white text-[#1f3f2b] font-semibold hover:bg-gray-100 transition">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- 14. FAQ -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="font-display text-3xl md:text-4xl font-bold text-center mb-12">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {faqs.map((f, i) => (
        <details class="group bg-white dark:bg-forest-700 rounded-2xl border border-leaf-200 dark:border-forest-600 p-5 cursor-pointer">
          <summary class="flex justify-between items-center font-semibold list-none">
            {f.q}
            <span class="text-[#2d5a3f] group-open:rotate-45 transition text-2xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-forest-700/80 dark:text-leaf-200/80 text-sm">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Footer />

  <!-- Slider Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slider = document.getElementById('slider');
      const slides = slider.querySelectorAll('.min-w-full');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const dots = document.querySelectorAll('.dot');
      let currentIndex = 0;
      const totalSlides = slides.length;
      let autoSlideInterval;

      function updateSlider() {
        slider.style.transform = `translateX(-${currentIndex * 100}%)`;
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-white', i === currentIndex);
          dot.classList.toggle('bg-white/50', i !== currentIndex);
        });
      }
      function nextSlide() { currentIndex = (currentIndex + 1) % totalSlides; updateSlider(); }
      function prevSlide() { currentIndex = (currentIndex - 1 + totalSlides) % totalSlides; updateSlider(); }
      function startAutoSlide() { autoSlideInterval = setInterval(nextSlide, 5000); }
      function resetAutoSlide() { clearInterval(autoSlideInterval); startAutoSlide(); }

      nextBtn.addEventListener('click', () => { nextSlide(); resetAutoSlide(); });
      prevBtn.addEventListener('click', () => { prevSlide(); resetAutoSlide(); });
      dots.forEach((dot, i) => dot.addEventListener('click', () => { currentIndex = i; updateSlider(); resetAutoSlide(); }));

      updateSlider();
      startAutoSlide();
    });
  </script>
</Layout>
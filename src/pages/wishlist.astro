---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Wishlist — HIVA">
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-forest-800 dark:text-leaf-100">My Wishlist</h1>
        <p class="text-sm text-forest-700/70 dark:text-leaf-200/70 mt-1">
          Products you've saved for later.
        </p>
      </div>
      <button
        id="clear-wishlist-btn"
        class="hidden text-xs font-semibold text-red-500 hover:text-red-600 transition"
      >
        Clear All
      </button>
    </div>

    <!-- EMPTY STATE -->
    <div id="wishlist-empty" class="hidden text-center py-20">
      <div class="text-6xl mb-4">💚</div>
      <h2 class="text-xl font-semibold mb-2 text-forest-800 dark:text-leaf-100">Your wishlist is empty</h2>
      <p class="text-sm text-forest-700/70 dark:text-leaf-200/70 mb-6">
        Tap the heart on any product to save it here.
      </p>
      <a href="/shop" class="inline-block px-6 py-3 rounded-full bg-leaf-600 text-white font-semibold hover:bg-leaf-700 transition">
        Browse Products
      </a>
    </div>

    <!-- GRID -->
    <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"></div>
  </main>

  <Footer />

  <script>
    import { wishlist, removeFromWishlist, clearWishlist, type WishlistItem } from '../stores/wishlist';

    const gridEl = document.getElementById('wishlist-grid')!;
    const emptyEl = document.getElementById('wishlist-empty')!;
    const clearBtn = document.getElementById('clear-wishlist-btn')!;

    const money = (n: number) => `₹${n.toFixed(2)}`;

    function renderCard(item: WishlistItem) {
      const discount = item.mrp && item.mrp > item.price
        ? Math.round(((item.mrp - item.price) / item.mrp) * 100)
        : 0;

      return `
        <div class="group relative flex flex-col rounded-2xl border border-leaf-200 dark:border-forest-600 bg-white dark:bg-forest-700 overflow-hidden hover:shadow-xl transition-all duration-300">
          ${discount > 0 ? `
            <span class="absolute top-3 right-3 z-10 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded-full">-${discount}%</span>
          ` : ''}

          <button
            data-action="remove"
            data-sku="${item.sku}"
            aria-label="Remove from wishlist"
            class="absolute top-3 left-3 z-10 w-8 h-8 rounded-full bg-white/90 text-red-500 hover:bg-red-500 hover:text-white flex items-center justify-center transition shadow"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>

          <a href="/product/${item.slug}" class="aspect-square w-full bg-leaf-50 dark:bg-forest-600 overflow-hidden">
            ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />` : ''}
          </a>

          <div class="p-4 flex flex-col flex-1">
            ${item.category ? `<p class="text-[10px] uppercase tracking-wider text-leaf-600 dark:text-leaf-300 mb-1">${item.category}</p>` : ''}
            <a href="/product/${item.slug}" class="font-semibold text-sm text-forest-800 dark:text-leaf-100 line-clamp-2 mb-2 hover:text-leaf-600">
              ${item.name}
            </a>

            <div class="mt-auto flex items-end justify-between gap-2">
              <div class="flex items-baseline gap-1.5">
                <span class="text-base font-bold text-forest-800 dark:text-leaf-100">₹${item.price}</span>
                ${item.mrp && item.mrp > item.price ? `<span class="text-xs line-through text-forest-700/50 dark:text-leaf-200/50">₹${item.mrp}</span>` : ''}
              </div>
              <button
                data-action="add-cart"
                data-sku="${item.sku}"
                data-slug="${item.slug}"
                data-name="${item.name}"
                data-price="${item.price}"
                data-mrp="${item.mrp ?? ''}"
                data-image="${item.image ?? ''}"
                aria-label="Add to cart"
                class="flex items-center justify-center w-9 h-9 rounded-full bg-leaf-600 hover:bg-leaf-700 text-white transition shrink-0"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function render() {
      const items = wishlist.get();
      if (items.length === 0) {
        gridEl.innerHTML = '';
        gridEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        clearBtn.classList.add('hidden');
        return;
      }
      gridEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');
      clearBtn.classList.remove('hidden');
      gridEl.innerHTML = items.map(renderCard).join('');
    }

    gridEl.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!target) return;
      e.preventDefault();
      const sku = target.dataset.sku!;
      const action = target.dataset.action!;

      if (action === 'remove') {
        removeFromWishlist(sku);
      }

      if (action === 'add-cart') {
        // Dynamic import to avoid bundling cart store if not needed
        const { addToCart } = await import('../stores/cart');
        addToCart({
          sku,
          slug: target.dataset.slug!,
          name: target.dataset.name!,
          size: 'Default',
          price: Number(target.dataset.price),
          mrp: target.dataset.mrp ? Number(target.dataset.mrp) : undefined,
          image: target.dataset.image || '',
        });
        target.classList.add('bg-[#4caf50]');
        setTimeout(() => target.classList.remove('bg-[#4caf50]'), 800);
      }
    });

    clearBtn.addEventListener('click', () => {
      if (confirm('Remove all items from your wishlist?')) clearWishlist();
    });

    render();
    wishlist.subscribe(render);
  </script>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact — HIVA">
  <Header />
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl font-bold mb-2">Get in touch</h1>
    <p class="text-forest-700/70 dark:text-leaf-200/70 mb-10">Bulk order? Question? We'd love to hear from you.</p>

    <form class="grid gap-5 max-w-xl">
      <input name="name" placeholder="Your name" required class="px-4 py-3 rounded-lg bg-white dark:bg-forest-700 border border-leaf-200 dark:border-forest-600 focus:outline-none focus:border-leaf-500" />
      <input name="phone" placeholder="Phone" required class="px-4 py-3 rounded-lg bg-white dark:bg-forest-700 border border-leaf-200 dark:border-forest-600 focus:outline-none focus:border-leaf-500" />
      <input name="email" type="email" placeholder="Email" class="px-4 py-3 rounded-lg bg-white dark:bg-forest-700 border border-leaf-200 dark:border-forest-600 focus:outline-none focus:border-leaf-500" />
      <textarea name="message" placeholder="Message" rows="5" required class="px-4 py-3 rounded-lg bg-white dark:bg-forest-700 border border-leaf-200 dark:border-forest-600 focus:outline-none focus:border-leaf-500"></textarea>
      <button class="px-6 py-3 rounded-full bg-leaf-600 hover:bg-leaf-700 text-white font-semibold transition">
        Send Enquiry
      </button>
    </form>
  </main>
  <Footer />
</Layout>